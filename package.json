{
  "name": "sawa",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sawa/web --filter @sawa/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@types/node": "^24",
    "typescript": "^5",
    "vitest": "^5"
  }
}
