# Copy to .env.local. Production values live in Railway, never in git.
PORT=8787
# Comma-separated; *.vercel.app previews of this project are matched by CORS_PREVIEW_PATTERN
CORS_ORIGINS=http://localhost:3000
CORS_PREVIEW_PATTERN=^https://sawa-[a-z0-9-]+\.vercel\.app$
LOG_LEVEL=info
# Route planner preview at /debug/planner (set 0 in production before the pitch)
DEBUG_PAGES=1
# R1: dane.um.warszawa.pl token for real departures; without it the planner uses GTFS headways
WAW_TOKEN=
# Production (Railway): the city blocks Railway's IPs, so calls go through Antek's proxy (#63).
# Locally leave both empty: the API calls dane.um.warszawa.pl directly.
# WAW_API_BASE_URL=https://sawa.rockydomek.party
# WAW_PROXY_KEY=
# Live vehicles (POST /v1/vehicles/track) need WAW_TOKEN. 1 = poll ZTM all the time
# (set on demo day); otherwise only for 20 min after a request
VEHICLES_ALWAYS_ON=0
# Walking legs along streets: OSRM foot profile (default FOSSGIS); empty = straight lines
# WALK_ROUTER_URL=https://routing.openstreetmap.de/routed-foot
# WALK_ROUTER_FALLBACK_URL=https://valhalla1.openstreetmap.de
# Requests at once to the walk router (default 8 for 127.0.0.1/localhost, else 2).
# WALK_ROUTER_MAX_IN_FLIGHT=

# Sawa's stories via OpenRouter; without the key a story is the place's facts read plainly
OPENROUTER_KEY=
# OPENROUTER_MODEL=google/gemini-3.5-flash-lite
# ElevenLabs key with Text to Speech permission; without it the local voice (below) reads
ELEVENLABS_KEY=
# Second key, tried when the first is refused (credits spent, 401/402/403/429)
ELEVENLABS_KEY_2=
# Local Polish voice (Piper "gosia" via sherpa-onnx) when ElevenLabs is missing or fails; 0 = off
# LOCAL_TTS=1
# Unpacked model; empty = downloaded to a temp folder at start (~70 MB). Docker: /models/...
# PIPER_MODEL_DIR=
# Google Places API (New): ride destination typed by name (GET /v1/destinations); without it 502
GOOGLE_PLACES_API_KEY=

# Added by their owners when the adapter lands (docs/12-plan-mvp.md):
# R2: places from Supabase; leave empty to serve 5 fake places (tests, offline demo)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# DEMO_OFFLINE=0                # R4
# Pitch mode (services/demo.ts): record = real LLM + ElevenLabs, saved to data/demo/;
# replay = only saved stories and voice, no LLM, ElevenLabs or Google Places calls.
DEMO_MODE=off
