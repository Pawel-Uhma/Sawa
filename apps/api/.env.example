# Copy to .env.local. Production values live in Railway, never in git.
PORT=8787
# Comma-separated; *.vercel.app previews of this project are matched by CORS_PREVIEW_PATTERN
CORS_ORIGINS=http://localhost:3000
CORS_PREVIEW_PATTERN=^https://sawa-[a-z0-9-]+\.vercel\.app$
LOG_LEVEL=info
# Route planner preview at /debug/planner (set 0 in production before the pitch)
DEBUG_PAGES=1
# R1: dane.um.warszawa.pl token for real departures; without it the planner uses GTFS headways
WAW_TOKEN=
# Live vehicles (POST /v1/vehicles/track) need WAW_TOKEN. 1 = poll ZTM all the time
# (set on demo day); otherwise only for 20 min after a request
VEHICLES_ALWAYS_ON=0

# Sawa's stories via OpenRouter; without the key a story is the place's facts read plainly
OPENROUTER_KEY=
# OPENROUTER_MODEL=google/gemini-3.5-flash-lite
# ElevenLabs key with Text to Speech permission; without it POST /v1/speech answers 502
ELEVENLABS_KEY=

# Added by their owners when the adapter lands (docs/12-plan-mvp.md):
# R2: places from Supabase; leave empty to serve 5 fake places (tests, offline demo)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# DEMO_OFFLINE=0                # R4
