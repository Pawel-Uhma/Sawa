# Copy to .env.local. Production values live in Railway, never in git.
PORT=8787
# Comma-separated; *.vercel.app previews of this project are matched by CORS_PREVIEW_PATTERN
CORS_ORIGINS=http://localhost:3000
CORS_PREVIEW_PATTERN=^https://sawa-[a-z0-9-]+\.vercel\.app$
LOG_LEVEL=info

