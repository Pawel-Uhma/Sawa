    "test": "vitest run",
    "demo:record": "node --import tsx src/scripts/demo-record.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1",
    "@hono/zod-validator": "^0.9.1",
    "@sawa/shared": "workspace:*",
    "@supabase/supabase-js": "^2.118.0",
    "hono": "^4.13.13",
    "pino": "^10",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  }
}
