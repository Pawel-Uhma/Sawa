{
  "name": "@sawa/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env.local --import tsx src/index.ts",
    "start": "node --import tsx src/index.ts",
