# Reverse proxy do dane.um.warszawa.pl z polskim IP (issue #63).
# Przepuszcza tylko POST /api/action/* z poprawnym X-Proxy-Key; resztę odrzuca 403.
{
	admin off
	auto_https off
}

:8080 {
	handle /health {
		respond "ok" 200
	}

	@allowed {
		method POST
		path /api/action/*
		header X-Proxy-Key {$PROXY_KEY}
	}

	handle @allowed {
		request_header -X-Proxy-Key
		reverse_proxy https://dane.um.warszawa.pl {
			header_up Host {upstream_hostport}
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			transport http {
				dial_timeout 5s
				response_header_timeout 20s
			}
		}
	}

	handle {
		respond 403
	}
}
